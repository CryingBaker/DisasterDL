# IMPORTANT: Split files and metadata CSV are versioned (they define the train/val/test split)
# DO NOT add to .gitignore:
#   flood_segmentation/data_analysis/splits_*.txt
#   flood_segmentation/data_analysis/dataset_metadata.csv
#   flood_segmentation/data_analysis/normalization_stats.json

# Building damage cached crops & outputs
building_damage/data/
building_damage/outputs/

